div#tab-auto.tab-section
  h1 Automation
  p.desc Manage automatic responses and lines.

  div.section-card
    div.section-header
      div.section-title
        h3 Auto Line
      label.switch
        input#autoline_enabled(type="checkbox") 
        span.slider
    div.form-group
      label Image URL
      input#autoline_image(type="text")
    div.form-group
      label Channels
      input#autoline_channels(type="text")

  div.section-card
    div.section-header
      div.section-title
        h3 Auto Reply
      label.switch
        input#autoreply_enabled(type="checkbox") 
        span.slider
    div#reply-list.list-container
    button.btn-add(type="button" onclick="addReplyRow()") 
      svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
        line(x1="12" y1="5" x2="12" y2="19")
        line(x1="5" y1="12" x2="19" y2="12")
      | Add New Reply

  div.section-card
    div.section-header
      div.section-title
        h3 Auto React
      label.switch
        input#autoreact_enabled(type="checkbox") 
        span.slider
    div#react-list.list-container
    button.btn-add(type="button" onclick="addReactRow()") 
       svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
         line(x1="12" y1="5" x2="12" y2="19")
         line(x1="5" y1="12" x2="19" y2="12")
       | Add Channel Config